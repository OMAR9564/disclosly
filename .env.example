# Copy to .env and replace placeholders. Never commit real values.
# Contract: specs/001-walking-skeleton/contracts/configuration.md

# --- API container ---
APP_ENV=development
APP_VERSION=dev
DATABASE_URL=postgresql://disclosly:CHANGE_ME@postgres:5432/disclosly
REDIS_URL=redis://redis:6379/0
CORS_ALLOWED_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus

# --- Postgres container ---
POSTGRES_USER=disclosly
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=disclosly

# --- Compose / Caddy (server .env) ---
API_IMAGE_TAG=main
API_DOMAIN=api.disclosly.com
ACME_EMAIL=ops@example.com

# --- Web (Vercel project env / build time) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_APP_VERSION=dev

# --- Ingestion / retrieval (worker, laptop bulk embed) ---
SEC_USER_AGENT=Disclosly ops@example.com
INGEST_DATA_DIR=/tmp/disclosly-ingest
CORPUS_DISK_LIMIT_GB=20
RETRIEVAL_CHUNKER_VERSION=v1-600-64
RETRIEVAL_RERANK=true
RETRIEVAL_CANDIDATES=50
RETRIEVAL_RERANK_TOP=20
RETRIEVAL_RERANK_MAX_LENGTH=64
RETRIEVAL_RERANK_QUANTIZE=true
EMBEDDING_MODEL=intfloat/multilingual-e5-small
RERANK_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1

# --- Model providers (API container); unset key = provider skipped ---
GEMINI_API_KEY=
GROQ_API_KEY=
GITHUB_MODELS_TOKEN=
OPENROUTER_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_TOKEN=
LLM_PROVIDERS_FILE=llm/providers.yaml

# --- Auth (API container) ---
GOOGLE_CLIENT_ID=CHANGE_ME
GOOGLE_CLIENT_SECRET=CHANGE_ME
GITHUB_CLIENT_ID=CHANGE_ME
GITHUB_CLIENT_SECRET=CHANGE_ME
# At least 32 characters outside development/test.
JWT_SECRET=CHANGE_ME
SESSION_COOKIE_DOMAIN=.disclosly.com
WEB_ORIGIN=http://localhost:3000
# Cloudflare Turnstile test keys (always pass); replace on the server.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# --- Quotas, rate limits and agent budget ---
QUOTA_DAILY_QUESTIONS=20
RATE_LIMIT_USER_PER_MIN=30
RATE_LIMIT_IP_PER_MIN=60
AGENT_MAX_MODEL_CALLS=4
AGENT_DEADLINE_SECONDS=90
AGENT_MAX_TOOL_CALLS=6

# --- Telemetry (empty = no-op) ---
OTEL_EXPORTER_OTLP_ENDPOINT=
