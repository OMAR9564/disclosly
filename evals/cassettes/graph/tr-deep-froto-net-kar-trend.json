    "content": "{\n  \"language\": \"tr\",\n  \"status\": \"completed\",\n  \"summary\": \"Ford Otosan 2025 yılında çeyreklik net kârı Q1'de 6,49 milyar TL'den Q2'de 6,11 milyar TL'ye %5,8 düşmüş, Q3'te ise 8,40 milyar TL'ye yükselerek Q2'ye göre %37,5 artış göstermiştir [1][2]. Bu veriler şirketin 2025 yılı ilk üç çeyreğine aittir; Q4 verisi henüz açıklanmamıştır [3].\",\n  \"points\": [\n    {\n      \"text\": \"2025-Q1 (Ocak-Mart) net dönem kârı 6.487.096.000 TL olarak gerçekleşmiştir.\",\n      \"cite_ids\": [\"f:2855\"]\n    },\n    {\n      \"text\": \"2025-Q2 (Nisan-Haziran) net dönem kârı 6.110.784.000 TL olarak gerçekleşmiştir.\",\n      \"cite_ids\": [\"f:2869\"]\n    },\n    {\n      \"text\": \"2025-Q3 (Temmuz-Eylül) net dönem kârı 8.401.456.000 TL olarak gerçekleşmiştir.\",\n      \"cite_ids\": [\"f:2879\"]\n    },\n    {\n      \"text\": \"Q1'den Q2'ye net kâr %5,8 azalmış (QoQ değişim: -5,80%).\",\n      \"cite_ids\": [\"k:1\"]\n    },\n    {\n      \"text\": \"Q2'den Q3'e net kâr %37,5 artmış (QoQ değişim: +37,49%).\",\n      \"cite_ids\": [\"k:2\"]\n    }\n  ],\n  \"tables\": [\n    {\n      \"title\": \"Ford Otosan 2025 Çeyreklik Net Kâr ve Çeyrekten Çeyreğe Değişim\",\n      \"columns\": [\"Dönem\", \"Net Kâr (TL)\", \"QoQ Değişim (%)\"],\n      \"rows\": [\n        [\n          {\"text\": \"2025-Q1\", \"cite_id\": \"f:2855\"},\n          {\"text\": \"6.487.096.000\", \"cite_id\": \"f:2855\"},\n          {\"text\": \"—\", \"cite_id\": null}\n        ],\n        [\n          {\"text\": \"2025-Q2\", \"cite_id\": \"f:2869\"},\n          {\"text\": \"6.110.784.000\", \"cite_id\": \"f:2869\"},\n          {\"text\": \"-5,80%\", \"cite_id\": \"k:1\"}\n        ],\n        [\n          {\"text\": \"2025-Q3\", \"cite_id\": \"f:2879\"},\n          {\"text\": \"8.401.456.000\", \"cite_id\": \"f:2879\"},\n          {\"text\": \"+37,49%\", \"cite_id\": \"k:2\"}\n        ]\n      ]\n    }\n  ],\n  \"chart\": {\n    \"kind\": \"line\",\n    \"table\": 0,\n    \"x_column\": \"Dönem\",\n    \"series\": [\"Net Kâr (TL)\"]\n  },\n  \"confidence\": {\n    \"level\": \"high\",\n    \"note\": \"2025 yılı ilk üç çeyrek için net kâr verileri ve QoQ değişim hesaplamaları tam olarak mevcuttur. 2025-Q4 verisi henüz açıklanmadığı için rapor bu dönem kapsamlı değildir.\"\n  },\n  \"unverified\": [],\n  \"citations\": [\n    {\"marker\": 1, \"cite_id\": \"f:2855\"},\n    {\"marker\": 2, \"cite_id\": \"f:2869\"},\n    {\"marker\": 3, \"cite_id\": \"f:2879\"},\n    {\"marker\": 4, \"cite_id\": \"k:1\"},\n    {\"marker\": 5, \"cite_id\": \"k:2\"}\n  ],\n  \"disclaimer\": \"Yatırım tavsiyesi değildir / Not investment advice\"\n}",
