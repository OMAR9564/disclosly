    "content": "{\n  \"language\": \"en\",\n  \"status\": \"completed\",\n  \"summary\": \"In 2024, Coca-Cola reported net income of $10.63 billion, while PepsiCo reported $9.58 billion [1][2]. In 2025, Coca-Cola's net income increased to $13.11 billion, whereas PepsiCo's decreased to $8.24 billion [3][4]. Coca-Cola's net income grew by approximately 23% year-over-year, while PepsiCo's fell by about 14%.\",\n  \"points\": [\n    {\n      \"text\": \"Coca-Cola net income for fiscal year 2024 was $10,631,000,000.\",\n      \"cite_ids\": [\"f:1575\"]\n    },\n    {\n      \"text\": \"Coca-Cola net income for fiscal year 2025 was $13,107,000,000.\",\n      \"cite_ids\": [\"f:1581\"]\n    },\n    {\n      \"text\": \"PepsiCo net income for fiscal year 2024 was $9,578,000,000.\",\n      \"cite_ids\": [\"f:1677\"]\n    },\n    {\n      \"text\": \"PepsiCo net income for fiscal year 2025 was $8,240,000,000.\",\n      \"cite_ids\": [\"f:1685\"]\n    }\n  ],\n  \"tables\": [\n    {\n      \"title\": \"Net Income Comparison (USD)\",\n      \"columns\": [\n        \"Year\",\n        \"Coca-Cola (KO)\",\n        \"PepsiCo (PEP)\"\n      ],\n      \"rows\": [\n        [\n          { \"text\": \"2024\" },\n          { \"text\": \"10,631,000,000\", \"cite_id\": \"f:1575\" },\n          { \"text\": \"9,578,000,000\", \"cite_id\": \"f:1677\" }\n        ],\n        [\n          { \"text\": \"2025\" },\n          { \"text\": \"13,107,000,000\", \"cite_id\": \"f:1581\" },\n          { \"text\": \"8,240,000,000\", \"cite_id\": \"f:1685\" }\n        ]\n      ]\n    }\n  ],\n  \"chart\": {\n    \"kind\": \"bar\",\n    \"table\": 0,\n    \"x_column\": \"Year\",\n    \"series\": [\n      \"Coca-Cola (KO)\",\n      \"PepsiCo (PEP)\"\n    ]\n  },\n  \"confidence\": {\n    \"level\": \"high\",\n    \"note\": \"Net income figures for both companies for both fiscal years 2024 and 2025 are available from the evidence.\"\n  },\n  \"unverified\": [],\n  \"citations\": [\n    { \"marker\": 1, \"cite_