    "content": "{\n  \"language\": \"tr\",\n  \"status\": \"partial\",\n  \"summary\": \"2024 ve 2025 yıllarına ait hasılat rakamları mevcut, ancak bu rakamların Koç Holding veya Sabancı Holding'e ait olduğu belgelerde belirtilmemiştir[1][2][3]. Bu nedenle iki şirketin hasılatlarını doğrudan karşılaştırmak mümkün değildir.\",\n  \"points\": [\n    {\n      \"text\": \"Belirtilen hasılat değerleri: 2024 FY 1.611.489.000.000 TRY, 2024 FY (2025 raporu) 2.109.310.000.000 TRY, 2025 FY 1.838.618.000.000 TRY.\",\n      \"cite_ids\": [\"f:2261\", \"f:2310\", \"f:2309\"]\n    },\n    {\n      \"text\": \"Rakamların hangi holdinge ait olduğu belgelerde yer almamaktadır.\",\n      \"cite_ids\": [\"f:2261\", \"f:2310\", \"f:2309\"]\n    }\n  ],\n  \"tables\": [\n    {\n      \"title\": \"Hasılat Rakamları (Şirket Ataması Belirtilmemiş)\",\n      \"columns\": [\"Dönem\", \"Hasılat (TRY)\"],\n      \"rows\": [\n        [\n          {\n            \"text\": \"2024 FY\",\n            \"cite_id\": null\n          },\n          {\n            \"text\": \"1.611.489.000.000\",\n            \"cite_id\": \"f:2261\"\n          }\n        ],\n        [\n          {\n            \"text\": \"2024 FY (2025 raporu)\",\n            \"cite_id\": null\n          },\n          {\n            \"text\": \"2.109.310.000.000\",\n            \"cite_id\": \"f:2310\"\n          }\n        ],\n        [\n          {\n            \"text\": \"2025 FY\",\n            \"cite_id\": null\n          },\n          {\n            \"text\": \"1.838.618.000.000\",\n            \"cite_id\": \"f:2309\"\n          }\n        ]\n      ]\n    }\n  ],\n  \"chart\": null,\n  \"confidence\": {\n    \"level\": \"low\",\n    \"note\": \"Rakamların hangi holdinge ait olduğu belgelerde belirtilmediği için karşılaştırma eksiktir.\"\n  },\n  \"unverified\": [\n    \"Koç Holding ve Sabancı Holding'e ait hasılat değerlerinin belirlenmesi\"\n  ],\n  \"citations\": [\n    {\n      \"marker\": 1,\n      \"cite_id\": \"f:2261\"\n    },