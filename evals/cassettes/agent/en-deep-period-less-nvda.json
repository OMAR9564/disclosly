    "content": "{\n  \"language\": \"en\",\n  \"status\": \"completed\",\n  \"summary\": \"NVIDIA's quarterly revenue has grown significantly over the last four reported quarters, from $46.7 billion in 2025-Q3 to $96.2 billion in 2026-Q3. Data for 2026-Q1 is not available in the current filings.\",\n  \"points\": [\n    {\n      \"text\": \"2025-Q3 revenue: $46,743,000,000\",\n      \"cite_ids\": [\"f:407\"]\n    },\n    {\n      \"text\": \"2025-Q4 revenue: $57,006,000,000 (up 21.9% from prior quarter)\",\n      \"cite_ids\": [\"f:409\"]\n    },\n    {\n      \"text\": \"2026-Q2 revenue: $81,615,000,000 (up 43.2% from 2025-Q4; note 2026-Q1 not reported)\",\n      \"cite_ids\": [\"f:411\"]\n    },\n    {\n      \"text\": \"2026-Q3 revenue: $96,221,000,000 (up 17.9% from prior quarter)\",\n      \"cite_ids\": [\"f:412\"]\n    }\n  ],\n  \"citations\": [\n    {\n      \"marker\": 1,\n      \"cite_id\": \"f:407\"\n    },\n    {\n      \"marker\": 2,\n      \"cite_id\": \"f:409\"\n    },\n    {\n      \"marker\": 3,\n      \"cite_id\": \"f:411\"\n    },\n    {\n      \"marker\": 4,\n      \"cite_id\": \"f:412\"\n    }\n  ],\n  \"disclaimer\": \"Yatırım tavsiyesi değildir / Not investment advice\"\n}",
